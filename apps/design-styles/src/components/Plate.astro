---
interface Props {
  href?: string;
  label: string;
  size?: "index" | "entry";
}

const { href, label, size = "index" } = Astro.props;
const classes = [
  "block overflow-hidden rounded-[var(--radius)] border border-border specimen-plate",
  "aspect-[5/3]",
  size === "entry" ? "w-80 sm:w-[28rem]" : "w-64 sm:w-80",
];
---

{
  href ? (
    <a href={href} aria-label={label} class:list={classes}>
      <slot />
    </a>
  ) : (
    <div class:list={classes}>
      <slot />
    </div>
  )
}

<style>
  .specimen-plate {
    --specimen-plate-fill: #141414;
    background-color: var(--specimen-plate-fill);
  }
</style>
