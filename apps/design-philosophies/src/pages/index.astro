---
import "@fontsource-variable/fraunces";
import "../styles/global.css";

import frauncesLatin from "@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Design Philosophies</title>
    <meta
      name="description"
      content="A site about design philosophies by Bridger Tower. Coming soon."
    />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="data:," />
    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
  </head>
  <body class="flex min-h-dvh flex-col">
    <main class="grid flex-1 place-items-center px-6">
      <div class="max-w-md text-center">
        <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
          design&#8209;philosophies
        </h1>
        <p class="mt-4 text-[color:var(--color-stub-muted)]">Coming soon.</p>
      </div>
    </main>
    <footer
      class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 p-6 text-sm text-[color:var(--color-stub-muted)]"
    >
      <a href="https://bridger.to">A design site by Bridger Tower</a>
      <span aria-hidden="true">·</span>
      <a href="https://design-books.com">design-books.com</a>
      <span aria-hidden="true">·</span>
      <a href="https://design-styles.com">design-styles.com</a>
      <span aria-hidden="true">·</span>
      <a href="https://design-dictionary.org">design-dictionary.org</a>
      <span aria-hidden="true">·</span>
      <a href="https://design-reference.com">design-reference.com</a>
    </footer>
  </body>
</html>
