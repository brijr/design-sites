---
import Layout from "../layouts/Layout.astro";
import { SITE_NAME } from "../lib/site";
---

<Layout title={`Not found — ${SITE_NAME}`} description="Term not found." path="/404">
  <section class="grid gap-4 py-16 text-center">
    <h1 class="term-title text-4xl">Not found</h1>
    <p class="text-[var(--color-ink-soft)]">That term is not in the dictionary.</p>
    <p>
      <a class="link text-[var(--color-accent)]" href="/">Back to all terms</a>
    </p>
  </section>
</Layout>
