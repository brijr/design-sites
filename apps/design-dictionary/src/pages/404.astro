---
import Layout from "../layouts/Layout.astro";
import { SITE_NAME } from "../lib/site";
---

<Layout title={`Not found — ${SITE_NAME}`} description="Term not found." path="/404">
  <section class="grid gap-4">
    <h1 class="font-display text-2xl font-semibold tracking-tight">Not found</h1>
    <p class="text-muted">That term is not in the dictionary.</p>
    <p>
      <a class="link" href="/">Back to all terms</a>
    </p>
  </section>
</Layout>
