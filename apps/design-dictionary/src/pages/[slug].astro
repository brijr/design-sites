---
import Layout from "../layouts/Layout.astro";
import { SITE_NAME } from "../lib/site";
import {
  CATEGORY_LABELS,
  getTerm,
  relatedTerms,
  sortTerms,
  terms,
} from "../lib/terms";

export function getStaticPaths() {
  return terms.map((entry) => ({
    params: { slug: entry.slug },
  }));
}

const { slug } = Astro.params;
const entry = getTerm(slug!);

if (!entry) {
  return Astro.redirect("/404");
}

const related = relatedTerms(entry);
const sorted = sortTerms();
const index = sorted.findIndex((item) => item.slug === entry.slug);
const previous = index > 0 ? sorted[index - 1] : undefined;
const next = index < sorted.length - 1 ? sorted[index + 1] : undefined;
---

<Layout
  title={`${entry.term} — ${SITE_NAME}`}
  description={entry.definition}
  path={`/${entry.slug}`}
>
  <article class="grid min-w-0 gap-12">
    <div class="grid gap-4">
      <div>
        <p class="text-sm text-zinc-400">
          <a class="link" href="/">Dictionary</a>
          <span aria-hidden="true"> · </span>
          {CATEGORY_LABELS[entry.category]}
        </p>
        <h1 class="font-medium">{entry.term}</h1>
        <p class="max-w-prose text-zinc-400">{entry.definition}</p>
      </div>
    </div>

    <div class="grid max-w-prose gap-2">
      <h2 class="font-medium">In practice</h2>
      <p class="text-zinc-400">{entry.detail}</p>
    </div>

    {
      related.length > 0 && (
        <section class="grid gap-2">
          <h2 class="font-medium">Related</h2>
          <p class="text-sm text-zinc-400">
            {related.map((item, i) => (
              <span>
                <a class="link" href={`/${item.slug}`}>
                  {item.term}
                </a>
                {i < related.length - 1 ? ", " : ""}
              </span>
            ))}
          </p>
        </section>
      )
    }

    <nav
      class="grid gap-4 border-t border-zinc-200 pt-6 text-sm sm:grid-cols-2"
      aria-label="Adjacent terms"
    >
      {
        previous ? (
          <a class="link grid gap-1" href={`/${previous.slug}`}>
            <span class="text-zinc-400">Previous</span>
            <span class="font-medium">{previous.term}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a class="link grid gap-1 sm:text-right" href={`/${next.slug}`}>
            <span class="text-zinc-400">Next</span>
            <span class="font-medium">{next.term}</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</Layout>
