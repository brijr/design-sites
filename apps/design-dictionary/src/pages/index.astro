---
import Layout from "../layouts/Layout.astro";
import { SITE_DESCRIPTION, SITE_NAME } from "../lib/site";
import {
  CATEGORIES,
  CATEGORY_LABELS,
  lettersInUse,
  sortTerms,
  terms,
  termsByLetter,
} from "../lib/terms";

const sorted = sortTerms(terms);
const byLetter = termsByLetter(sorted);
const letters = lettersInUse(sorted);
---

<Layout title={SITE_NAME} description={SITE_DESCRIPTION} path="/">
  <section class="catalog grid min-w-0 gap-12" data-dictionary>
    <div>
      <h1 class="font-medium">One hundred words every designer should know.</h1>
      <p class="text-zinc-400">
        Interface, typography, and foundational principles — in plain language.
      </p>
    </div>

    <div class="grid gap-4">
      <label class="grid gap-2">
        <span class="sr-only">Search terms</span>
        <input
          class="w-full max-w-md border-b border-zinc-200 bg-transparent py-2 text-base outline-none placeholder:text-zinc-400 focus:border-zinc-950"
          type="search"
          name="q"
          placeholder="Search — hierarchy, kerning, affordance…"
          autocomplete="off"
          data-search
        />
      </label>

      <fieldset class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-zinc-400">
        <legend class="sr-only">Filter by category</legend>
        <label class="cursor-pointer">
          <input
            class="sr-only"
            type="radio"
            name="category"
            value="all"
            checked
            data-category
          />
          All
        </label>
        {
          CATEGORIES.map((category) => (
            <label class="cursor-pointer">
              <input
                class="sr-only"
                type="radio"
                name="category"
                value={category}
                data-category
              />
              {CATEGORY_LABELS[category]}
            </label>
          ))
        }
      </fieldset>

      <nav
        aria-label="Jump to letter"
        class="flex flex-wrap gap-x-3 gap-y-1 text-sm text-zinc-400"
      >
        {
          letters.map((letter) => (
            <a class="link" href={`#letter-${letter}`} data-letter-link={letter}>
              {letter}
            </a>
          ))
        }
      </nav>

      <p class="text-sm text-zinc-400" data-count aria-live="polite">
        {sorted.length} terms
      </p>
    </div>

    <div class="grid gap-10" data-results>
      {
        [...byLetter.entries()].map(([letter, entries]) => (
          <section
            class="letter-group grid gap-4"
            data-letter={letter}
            id={`letter-${letter}`}
          >
            <h2 class="sticky top-0 z-10 bg-zinc-50/90 py-2 font-medium backdrop-blur-sm pointer-events-none">
              {letter}
            </h2>
            <ul class="grid gap-0 divide-y divide-zinc-200 border-y border-zinc-200">
              {entries.map((entry) => (
                <li
                  class="term-row"
                  data-term
                  data-category={entry.category}
                  data-name={entry.term.toLowerCase()}
                  data-definition={entry.definition.toLowerCase()}
                >
                  <a
                    class="group grid gap-1 py-4 sm:grid-cols-[minmax(9rem,14rem)_1fr] sm:gap-6"
                    href={`/${entry.slug}`}
                  >
                    <span class="font-medium group-hover:underline group-hover:underline-offset-2">
                      {entry.term}
                    </span>
                    <span class="grid gap-1">
                      <span class="text-zinc-400">{entry.definition}</span>
                      <span class="text-sm text-zinc-400">
                        {CATEGORY_LABELS[entry.category]}
                      </span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <p class="hidden text-zinc-400" data-empty>No terms match that search.</p>
  </section>
</Layout>

<style>
  .catalog label:has(:checked) {
    color: var(--color-zinc-950);
  }

  .catalog label:has(:focus-visible) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .term-row.is-hidden {
    display: none;
  }

  .letter-group.is-empty {
    display: none;
  }
</style>

<script>
  const root = document.querySelector("[data-dictionary]");
  if (root instanceof HTMLElement) {
    const search = root.querySelector("[data-search]");
    const count = root.querySelector("[data-count]");
    const empty = root.querySelector("[data-empty]");
    const rows = [...root.querySelectorAll("[data-term]")];
    const groups = [...root.querySelectorAll("[data-letter]")];
    const letterLinks = [...root.querySelectorAll("[data-letter-link]")];

    const selectedCategory = () => {
      const checked = root.querySelector<HTMLInputElement>(
        "[data-category]:checked",
      );
      return checked?.value ?? "all";
    };

    const apply = () => {
      const query =
        search instanceof HTMLInputElement
          ? search.value.trim().toLowerCase()
          : "";
      const category = selectedCategory();
      let visible = 0;

      for (const row of rows) {
        if (!(row instanceof HTMLElement)) continue;
        const name = row.dataset.name ?? "";
        const definition = row.dataset.definition ?? "";
        const rowCategory = row.dataset.category ?? "";
        const matchesQuery =
          query.length === 0 ||
          name.includes(query) ||
          definition.includes(query);
        const matchesCategory = category === "all" || rowCategory === category;
        const show = matchesQuery && matchesCategory;
        row.classList.toggle("is-hidden", !show);
        if (show) visible += 1;
      }

      for (const group of groups) {
        if (!(group instanceof HTMLElement)) continue;
        const hasVisible = group.querySelector("[data-term]:not(.is-hidden)");
        group.classList.toggle("is-empty", !hasVisible);
        const letter = group.dataset.letter;
        const link = letterLinks.find(
          (item) =>
            item instanceof HTMLElement && item.dataset.letterLink === letter,
        );
        if (link instanceof HTMLElement) {
          link.classList.toggle("opacity-35", !hasVisible);
          link.style.pointerEvents = hasVisible ? "auto" : "none";
        }
      }

      if (count) {
        count.textContent = `${visible} term${visible === 1 ? "" : "s"}`;
      }
      empty?.classList.toggle("hidden", visible > 0);
    };

    root.addEventListener("input", apply);
    root.addEventListener("change", apply);
  }
</script>
