---
import "@fontsource-variable/ibm-plex-sans";
import "@fontsource/ibm-plex-serif/400.css";
import "@fontsource/ibm-plex-serif/600.css";
import "../styles/global.css";

import ibmPlexSansLatin from "@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url";

import { SITE_DESCRIPTION, SITE_NAME } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  path: string;
}

const { title, description = SITE_DESCRIPTION, path } = Astro.props;
const canonical = new URL(path, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:," />
    <link rel="canonical" href={canonical} />
    <link
      rel="preload"
      href={ibmPlexSansLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Bridger Tower" />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <div class="grid min-w-0 max-w-[var(--container)] gap-12 p-6 sm:p-12">
      <nav>
        <h2 class="font-display text-lg font-semibold tracking-tight">
          <a href="/" class="group text-foreground">
            {SITE_NAME}
          </a>
        </h2>
      </nav>

      <main>
        <slot />
      </main>

      <footer class="grid gap-1 text-xs text-muted">
        <p>
          © design-dictionary.org / made by
          <a href="https://bridger.to" class="link">bridger</a>
          @
          <a href="https://wipdes.com" class="link">wip</a>
        </p>
      </footer>
    </div>
  </body>
</html>
